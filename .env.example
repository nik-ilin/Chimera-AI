# Chimera — Environment Variables
# Copy this file to .env.local (frontend) and .env (backend).
# NEVER commit files with real values. All secrets stay local or in your CI secrets store.
# See CONVENTIONS.md Section 1 for the full security policy.

# ─── NEXT.JS FRONTEND (/frontend/.env.local) ──────────────────────────────────

# NextAuth v5 (Auth.js) — use the canonical AUTH_* names. NEXTAUTH_* also work
# via v5 back-compat, but frontend/.env.local uses AUTH_SECRET, so we
# standardise on AUTH_* here to match the working runtime.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The public URL of the Next.js app (no trailing slash). Optional in dev —
# Auth.js infers it from the request — but set explicitly for the :3005 port.
AUTH_URL=http://localhost:3005

# GitHub OAuth App credentials (create at github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth credentials (create at console.cloud.google.com → OAuth 2.0 Client IDs)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase — public keys (safe to expose to browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase JWT secret — signs the per-user access token minted in the NextAuth
# session callback so Route Handlers query Supabase under RLS (next_auth.uid()).
# Server-side ONLY (never NEXT_PUBLIC_). Copy from Supabase Dashboard →
# Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=
# Supabase service-role key — used server-side by SupabaseAdapter in
# frontend/src/lib/auth.ts (NextAuth writes to the next_auth schema).
# Server-side ONLY. Also required by the FastAPI backend (see below).
SUPABASE_SERVICE_ROLE_KEY=
# Internal service token — shared secret between Next.js and FastAPI.
# Next.js Route Handlers send this in: Authorization: Bearer <token>
# FastAPI rejects any request without it.
# Generate with: openssl rand -hex 32
CHIMERA_SERVICE_TOKEN=

# FastAPI base URL (never exposed to the browser — only used in Route Handlers)
FASTAPI_INTERNAL_URL=http://localhost:8000


# ─── PYTHON FASTAPI BACKEND (/backend/.env) ────────────────────────────────────

# Internal service token — must match the value set in the frontend above
CHIMERA_SERVICE_TOKEN=

# CORS — comma-separated list of allowed origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3005

# ── IBM watsonx.ai / Granite ──
# API key from IBM Cloud → Manage → Access (IAM) → API keys
WATSONX_API_KEY=
# Project ID from your Watson Studio / watsonx.ai project settings
WATSONX_PROJECT_ID=
# Regional endpoint — e.g. https://us-south.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite model ID — e.g. ibm/granite-3-8b-instruct
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# ── LangFlow ──
# Base URL of your LangFlow instance (local or cloud)
LANGFLOW_BASE_URL=http://localhost:7860
# LangFlow API key (required if LangFlow auth is enabled)
LANGFLOW_API_KEY=

# ── HuggingFace (Stable Diffusion image generation) ──
# Token from huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
# Model endpoint path — e.g. stabilityai/stable-diffusion-xl-base-1.0
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ── Supabase (backend — service-role key, NEVER exposed to browser) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Calendar API ──
# OAuth 2.0 client credentials (same Google Cloud project as AUTH_GOOGLE above)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI registered in Google Cloud Console for the backend OAuth flow
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback
# Encryption key for storing Google refresh tokens at rest (32-byte hex)
# Generate with: openssl rand -hex 32
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Ticketmaster Discovery API ──
# API key from developer.ticketmaster.com (instant free-tier approval)
TICKETMASTER_API_KEY=

# ── Instagram (Instagrapi — demo account only, see CONVENTIONS.md risk notes) ──
INSTAGRAM_USERNAME=
# Password is encrypted by the application at runtime; this is the plaintext seed
# used only on first login. After first login, session file is used instead.
INSTAGRAM_PASSWORD=

# ── Application settings ──
# "development" or "production"
APP_ENV=development
# DEBUG enables prompt+response logging for AI calls (never enable in production)
LOG_LEVEL=INFO
